<%- include('partials/header') %>

<main class="container page-content">
  <section class="page-intro">
    <p class="eyebrow">Community partners</p>
    <h1><%= title %></h1>
    <p>Meet organizations that represent different ways to strengthen and support our communities.</p>
  </section>

  <section class="organization-list" aria-label="Partner organizations">
    <article class="organization-card">
      <img src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo">
      <div>
        <h2>BrightFuture Builders</h2>
        <p>Supports educational growth and learning opportunities for people in the community.</p>
        <a href="mailto:info@brightfuture.org">info@brightfuture.org</a>
      </div>
    </article>


    <article class="organization-card">
      <img src="/images/greenharvest-logo.png" alt="GreenHarvest Growers logo">
      <div>
        <h2>GreenHarvest Growers</h2>
        <p>Encourages environmental care, community gardens, and sustainable local projects.</p>
        <a href="mailto:contact@greenharvest.org">contact@greenharvest.org</a>
      </div>
    </article>


    <article class="organization-card">
      <img src="/images/unityserve-logo.png" alt="UnityServe Volunteers logo">
      <div>
        <h2>UnityServe Volunteers</h2>
        <p>Connects volunteers with practical opportunities to help neighbors and local groups.</p>
        <a href="mailto:hello@unityserve.org">hello@unityserve.org</a>
      </div>
    </article>

    
  </section>
  <p class="notice">These sample partner profiles are demonstration content for the initial course project.</p>
</main>

<%- include('partials/footer') %>
