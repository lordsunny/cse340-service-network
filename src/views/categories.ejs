<%- include('partials/header') %>

<main class="container page-content">
  <section class="page-intro">
    <p class="eyebrow">Explore causes</p>
    <h1><%= title %></h1>
    <p>Choose an area of service that interests you. Each category offers a different way to contribute.</p>
  </section>

  <section class="card-grid">
    <article class="info-card category-card">
      <span class="category-symbol" aria-hidden="true">♻</span>
      <h2>Environmental</h2>
      <p>Care for the natural environment through clean-ups, gardening, conservation, and sustainability projects.</p>
    </article>


    <article class="info-card category-card">
      <span class="category-symbol" aria-hidden="true">✎</span>
      <h2>Educational</h2>
      <p>Support learning through tutoring, reading programs, mentoring, and educational resources.</p>
    </article>


    <article class="info-card category-card">
      <span class="category-symbol" aria-hidden="true">♡</span>
      <h2>Community Service</h2>
      <p>Strengthen neighborhoods by helping local groups, families, and community improvement projects.</p>
    </article>

    
    <article class="info-card category-card">
      <span class="category-symbol" aria-hidden="true">+</span>
      <h2>Health and Wellness</h2>
      <p>Encourage well-being by assisting with community events and approved health education activities.</p>
    </article>
  </section>
</main>

<%- include('partials/footer') %>
