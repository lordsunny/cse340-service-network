<%- include('partials/header') %>

<main>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Connect. Serve. Strengthen communities.</p>
        <h1>Make a difference, one act of service at a time.</h1>
        <p class="hero-text">Discover local organizations, explore meaningful projects, and find a service opportunity that matches your interests and skills.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/projects">Explore projects</a>
          <a class="button button-secondary" href="/organizations">Meet our partners</a>
        </div>


      </div>
      <div class="hero-art">
        <img class="main-logo" src="/images/cse340-service-network.png" alt="CSE 340 Service Network illustration">
      </div>
    </div>

    
  </section>
  <section class="section container">
    <div class="section-heading">
      <p class="eyebrow">Find your place</p>
      <h2>Ways to get involved</h2>
      <p>Whether you want to teach, protect the environment, or support your neighbors, there is a place for you.</p>
    </div>


    <div class="card-grid">
      <article class="info-card">
        <span class="card-icon" aria-hidden="true">01</span>
        <h3>Find organizations</h3>
        <p>Connect with community partners who are working to make a positive difference.</p>
        <a href="/organizations">View organizations <span aria-hidden="true">→</span></a>
      </article>


      <article class="info-card">
        <span class="card-icon" aria-hidden="true">02</span>
        <h3>Explore projects</h3>
        <p>Discover service activities and learn how you can contribute your time and skills.</p>
        <a href="/projects">Browse projects <span aria-hidden="true">→</span></a>
      </article>


      <article class="info-card">
        <span class="card-icon" aria-hidden="true">03</span>
        <h3>Choose a category</h3>
        <p>Start with a cause that matters to you and explore related opportunities.</p>
        <a href="/categories">See categories <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="callout">
    <div class="container callout-inner">
      <div>
        <p class="eyebrow">Small actions matter</p>
        <h2>Find an opportunity to serve your community.</h2>
      </div>
      <a class="button button-light" href="/projects">Find a project</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
