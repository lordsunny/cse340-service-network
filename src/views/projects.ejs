<%- include('partials/header') %>

<main class="container page-content">
  <section class="page-intro">
    <p class="eyebrow">Take part</p>
    <h1><%= title %></h1>
    <p>Explore service opportunities and consider how your time and talents can help.</p>
  </section>

  <section class="card-grid project-grid">
    <% if (projects.length) { %>
      <% projects.forEach((project) => { %>
        <article class="info-card project-card">
          <span class="tag">
            <%= project.categories && project.categories.length
              ? project.categories.join(' · ')
              : 'Service Project' %>
          </span>
          <h2><%= project.title %></h2>
          <p><%= project.description %></p>
          <p class="project-meta">
            <strong>Location:</strong> <%= project.location %>
          </p>
          <p class="project-meta">
            <strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC'
            }) %>
            (<%= project.organization_name %>)
          </p>
        </article>
      <% }); %>
    <% } else { %>
      <p>No service projects are currently available.</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
