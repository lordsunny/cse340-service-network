<%- include('partials/header') %>

<main class="container page-content">
  <section class="page-intro">
    <p class="eyebrow">Take part</p>
    <h1><%= title %></h1>
    <p>Explore sample service opportunities and consider how your time and talents can help.</p>
  </section>


  <section class="card-grid project-grid">
    <article class="info-card project-card">
      <span class="tag">Environmental</span>
      <h2>Community Garden Day</h2>
      <p>Help prepare garden beds, plant seedlings, and care for a shared green space.</p>
      <p class="project-meta"><strong>Suggested activity:</strong> Gardening and outdoor work</p>
    </article>


    <article class="info-card project-card">
      <span class="tag">Educational</span>
      <h2>Reading Support</h2>
      <p>Encourage young learners by reading together and supporting basic literacy practice.</p>
      <p class="project-meta"><strong>Suggested activity:</strong> Reading and mentoring</p>
    </article>


    <article class="info-card project-card">
      <span class="tag">Community Service</span>
      <h2>Neighborhood Clean-up</h2>
      <p>Work with other volunteers to collect litter and improve a shared public area.</p>
      <p class="project-meta"><strong>Suggested activity:</strong> Teamwork and clean-up</p>
    </article>

    
    <article class="info-card project-card">
      <span class="tag">Health and Wellness</span>
      <h2>Wellness Check-in</h2>
      <p>Support a community wellness event by welcoming visitors and sharing approved resources.</p>
      <p class="project-meta"><strong>Suggested activity:</strong> Event support</p>
    </article>
  </section>
  <p class="notice">Projects shown here are examples for the initial site. They are not confirmed live volunteer openings.</p>
</main>

<%- include('partials/footer') %>
